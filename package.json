{
  "name": "@hsrcpay/sdk",
  "version": "0.2.0",
  "description": "Official Node.js SDK for HSRCPay: create, confirm, capture, cancel and refund payments with typed responses and built-in retries",
  "keywords": [
    "hsrcpay",
    "payments",
    "payment-orchestration",
    "sdk",
    "typescript"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Phine Up LLC",
    "email": "info@phineup.com",
    "url": "https://phineup.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsrcpay/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hsrcpay/node-sdk/issues"
  },
  "homepage": "https://hsrcpay.com",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun scripts/build.ts && bun scripts/verify-dist.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dts-bundle-generator": "^10.0.0",
    "typescript": "^5.9.0"
  },
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.6.7"
  }
}
